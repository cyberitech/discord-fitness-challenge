# FCB environment — copy to .env and fill in.
# The real .env on the host is mode 600 and never committed.

# --- Discord ---
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_OAUTH_CLIENT_ID=your-application-id
DISCORD_OAUTH_CLIENT_SECRET=your-oauth-client-secret
DISCORD_GUILD_ID=your-guild-id
DISCORD_CHANNEL_ID=your-monitored-channel-id

# --- Dashboard ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SESSION_SECRET=change-me
# Loopback port nginx reverse-proxies to
FCB_WEB_PORT=8765

# --- Bedrock (defaults match steering/bedrock.md) ---
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-6-v1
AWS_REGION=us-west-2

# --- Paths (defaults are relative to the repo root) ---
FCB_DB_PATH=data/fcb.db
FCB_SCREENSHOTS_DIR=data/screenshots

# --- Logging ---
LOG_LEVEL=INFO

# --- Nag scheduler ---
# Master switch; set false to disable all nags without changing per-event settings.
FCB_NAG_ENABLED=true
# How often the bot scans for slackers. Accepts fractional hours (e.g. 0.5).
FCB_NAG_INTERVAL_HOURS=1
# Minimum hours between nags to the same user for the same event.
FCB_NAG_COOLDOWN_HOURS=24

# --- Lifecycle scheduler ---
# How often the bot checks for start / end announcements and ending-soon
# reminders. Small values are fine; each scan is cheap. This must be short
# enough that dashboard-created events feel like they announce immediately.
FCB_LIFECYCLE_INTERVAL_MINUTES=5
# End-announcement grace window. If an event ended more than this many hours
# ago the winner shoutout is silently skipped (still marked announced so we
# don't loop). Start announcements ignore this — a past starts_at always
# announces on the next scan.
FCB_LIFECYCLE_GRACE_HOURS=24
# Master switch for the ending-soon reminders (halfway / 1w / 3d / 1d).
FCB_REMINDERS_ENABLED=true
# When true (default) the bot stays silent on any image it doesn't
# recognize as part of an active challenge. When false the bot always
# replies to images, using the hardcore-riff voice mode for anything
# not recognized (comments on whatever's visible in the image and
# ties it back to fitness/health).
FCB_REPLY_ONLY_ON_CHALLENGE_MATCH=true
# Lead time for the "coming up soon" pre-start announcement. Fires when
# an event's starts_at is within this many hours from now and it hasn't
# yet started. 0 disables upcoming announcements.
FCB_UPCOMING_LEAD_HOURS=48

# --- Command rate limiting ---
FCB_COMMAND_COOLDOWN_SECONDS=30

# --- @-mention chat context ---
FCB_CHAT_HISTORY_MESSAGES=100
