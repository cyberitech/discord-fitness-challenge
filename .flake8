[flake8]
max-line-length = 100
extend-select = E,W,F
extend-ignore = E203,W503
exclude = .venv,.mypy_cache,__pycache__,build,dist
# The agent prompt files are prose sent to Bedrock verbatim. Paragraphs
# are single physical lines by convention so the LLM sees natural
# paragraph flow; wrapping them at 100 chars would fragment prompts.
per-file-ignores =
    src/fcb/agents/__init__.py:E501
    src/fcb/agents/vision.py:E501
    src/fcb/agents/voice.py:E501
